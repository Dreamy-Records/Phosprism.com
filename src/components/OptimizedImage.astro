---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  draggable?: boolean;
  ariaHidden?: boolean | 'true' | 'false';
  widths?: number[];
  sizes?: string;
  /** WebPの品質。95以上ならPNGは可逆WebPになる */
  quality?: number;
  fetchpriority?: 'high' | 'low' | 'auto';
  /** true にすると読み込みを後回しにする（data-srcset に入れ、スクリプト側で差し替える） */
  deferred?: boolean;
  /** 縦長の画面で代わりに表示する画像（トップのスライドのスマホ版など） */
  mobileSrc?: string;
  /** mobileSrc を使う画面の条件 */
  mobileMedia?: string;
}

const {
  src,
  alt,
  class: className,
  loading,
  decoding,
  draggable,
  ariaHidden,
  widths,
  sizes,
  quality = 95,
  fetchpriority,
  deferred = false,
  mobileSrc,
  mobileMedia = '(max-aspect-ratio: 3/4)',
} = Astro.props;

const localImages = import.meta.glob<ImageMetadata>(
  [
    '../assets/**/*.avif',
    '../assets/**/*.jpg',
    '../assets/**/*.jpeg',
    '../assets/**/*.png',
    '../assets/**/*.webp',
  ],
  {
    eager: true,
    import: 'default',
  },
);
const findImage = (path: string) => {
  const found = localImages[`..${decodeURIComponent(path)}`];
  if (!found) throw new Error(`最適化対象の画像が見つかりません: ${path}`);
  return found;
};
const image = findImage(src);

// 元画像より大きいサイズは作らない（拡大しても画質は上がらず、容量だけ増えるため）
const getOutputWidths = (target: ImageMetadata) => {
  const requestedWidths = widths ?? [320, 640, 960, 1280];
  const responsiveWidths = requestedWidths.filter((width) => width < target.width);
  if (widths && requestedWidths.some((width) => width >= target.width)) {
    responsiveWidths.push(target.width);
  }
  return responsiveWidths.length ? responsiveWidths : [target.width];
};
const createSrcset = async (target: ImageMetadata) => {
  const outputWidths = getOutputWidths(target);
  const sources = await Promise.all(
    outputWidths.map((width) => getImage({ src: target, width, format: 'webp', quality })),
  );
  return sources.map((source, index) => `${source.src} ${outputWidths[index]}w`).join(', ');
};
const srcset = await createSrcset(image);
const mobileSrcset = mobileSrc ? await createSrcset(findImage(mobileSrc)) : undefined;
const fallbackFormat = image.format === 'webp' || image.format === 'avif' ? 'png' : image.format;
const fallback = await getImage({
  src: image,
  width: Math.min(image.width, 960),
  format: fallbackFormat,
  quality: 95,
});
---

<picture>
  {
    mobileSrcset && (
      <source
        media={mobileMedia}
        srcset={deferred ? undefined : mobileSrcset}
        data-srcset={deferred ? mobileSrcset : undefined}
        sizes={sizes ?? '100vw'}
        type="image/webp"
      />
    )
  }
  <source
    srcset={deferred ? undefined : srcset}
    data-srcset={deferred ? srcset : undefined}
    sizes={sizes ?? '100vw'}
    type="image/webp"
  />
  <img
    src={deferred ? undefined : fallback.src}
    data-src={deferred ? fallback.src : undefined}
    data-deferred-image={deferred ? '' : undefined}
    fetchpriority={fetchpriority}
    alt={alt}
    width={fallback.attributes.width}
    height={fallback.attributes.height}
    class={className}
    loading={loading}
    decoding={decoding}
    draggable={draggable}
    aria-hidden={ariaHidden}
  />
</picture>
