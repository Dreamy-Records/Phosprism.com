---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import NewsListing from '../../../components/NewsListing.astro';
import { defaultLabel } from '../../../data/labels';
import { articlesPerPage, countNews, getNewsByLabel, pageCount } from '../../../utils/newsPages';

export async function getStaticPaths() {
  const newsByLabel = await getNewsByLabel();
  const articles = newsByLabel[defaultLabel];
  const totalPages = pageCount(articles);

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const currentPage = index + 2;
    const startIndex = (currentPage - 1) * articlesPerPage;
    return {
      params: { page: String(currentPage) },
      props: { newsByLabel, currentPage, totalPages, startIndex },
    };
  });
}

const { newsByLabel, currentPage, totalPages, startIndex } = Astro.props;
const articles = newsByLabel[defaultLabel];
---

<SiteLayout title={`News — Page ${currentPage} — Phos'Prism`} page="news">
  <NewsListing
    label={defaultLabel}
    labelCounts={countNews(newsByLabel)}
    articles={articles.slice(startIndex, startIndex + articlesPerPage)}
    allArticles={articles}
    currentPage={currentPage}
    totalPages={totalPages}
    startIndex={startIndex}
  />
</SiteLayout>
