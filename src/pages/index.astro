---
import SiteLayout from '../layouts/SiteLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

// mobile: 縦長の画面（スマホなど）で代わりに表示する画像
const slides: { src: string; mobile?: string }[] = [
  { src: '/assets/phosprism header.png', mobile: '/assets/phosprism header mobile.png' },
  { src: '/assets/future_alice.png' },
  { src: '/assets/DDF.01.webp' },
];
---

<SiteLayout title="Phos'Prism">
  <main class="home">
    <div class="hero-slides" aria-hidden="true">
      {
        slides.map((slide, index) => (
          <OptimizedImage
            class="hero-slide"
            src={slide.src}
            mobileSrc={slide.mobile}
            alt=""
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            widths={[480, 640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            quality={index === 0 ? 80 : 72}
            fetchpriority={index === 0 ? 'high' : undefined}
            deferred={index > 0}
          />
        ))
      }
    </div>
    <div class="shade"></div>
    <div class="grain"></div>
    <div class="hero-content">
      <h1 class="hero-catchphrase">
        <span class="hero-catchphrase-line hero-catchphrase-line-beyond">
          <span class="hero-catchphrase-text">I NTO</span>
        </span>
        <span class="hero-catchphrase-line hero-catchphrase-line-the">
          <span class="hero-catchphrase-text">THE</span>
        </span>
        <span class="hero-catchphrase-line hero-catchphrase-line-dream">
          <span class="hero-catchphrase-text">LIGHT.</span>
        </span>
      </h1>
    </div>
  </main>
</SiteLayout>

<script>
  import gsap from 'gsap';

  const slides = gsap.utils.toArray<HTMLImageElement>('.hero-slide');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;
  let slideshowTimer: number | undefined;

  const stopSlideshow = () => {
    if (slideshowTimer !== undefined) {
      window.clearInterval(slideshowTimer);
      slideshowTimer = undefined;
    }
    gsap.killTweensOf(slides);
  };

  // 2枚目以降のスライドは、表示する少し前に1枚ずつ読み込む
  const loadSlide = (slide: HTMLImageElement | undefined) => {
    if (!slide?.hasAttribute('data-deferred-image')) return;
    slide.parentElement?.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((source) => {
      source.srcset = source.dataset.srcset ?? '';
      source.removeAttribute('data-srcset');
    });
    if (slide.dataset.src) {
      slide.src = slide.dataset.src;
      slide.removeAttribute('data-src');
    }
    slide.removeAttribute('data-deferred-image');
  };
  const loadNextSlide = () => loadSlide(slides[(current + 1) % slides.length]);

  const startSlideshow = () => {
    if (!slides.length) return;

    stopSlideshow();
    current = 0;
    gsap.set(slides, { opacity: 0, xPercent: 100, zIndex: 0 });
    gsap.set(slides[0], { opacity: 1, xPercent: 0, scale: 1.08, zIndex: 1 });

    if (reduceMotion || slides.length < 2) return;

    gsap.to(slides[0], { scale: 1, duration: 4.1, ease: 'none' });
    // 最初の切り替えに間に合うよう、2枚目はページの表示が終わってから読み込む
    if (document.readyState === 'complete') window.setTimeout(loadNextSlide, 2000);
    else window.addEventListener('load', () => window.setTimeout(loadNextSlide, 2000), { once: true });
    slideshowTimer = window.setInterval(() => {
      const previous = slides[current];
      current = (current + 1) % slides.length;
      const next = slides[current];

      loadSlide(next);
      loadNextSlide();

      gsap
        .timeline()
        .set(next, { opacity: 1, xPercent: 100, scale: 1.08, zIndex: 2 })
        .to(previous, { xPercent: -100, duration: 1.05, ease: 'power3.inOut' }, 0)
        .to(next, { xPercent: 0, duration: 1.05, ease: 'power3.inOut' }, 0)
        .set(previous, { opacity: 0, xPercent: 100, zIndex: 0 })
        .set(next, { zIndex: 1 })
        .to(next, { scale: 1, duration: 4.1, ease: 'none' });
    }, 5200);
  };

  startSlideshow();
  window.addEventListener('pagehide', stopSlideshow);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) startSlideshow();
  });
</script>
