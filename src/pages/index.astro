---
import SiteLayout from '../layouts/SiteLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const slides = [
  '/assets/phosprism header.png',
  '/assets/futuremagic.webp',
  '/assets/DDF.01.webp',
];
---

<SiteLayout title="Phos'Prism">
  <main class="home">
    <div class="hero-slides" aria-label="Phos'Prism ビジュアル">
      {
        slides.map((src, index) => (
          <OptimizedImage
            class="hero-slide"
            src={src}
            alt=""
            ariaHidden={index === 0 ? 'false' : 'true'}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            quality={80}
            fetchpriority={index === 0 ? 'high' : undefined}
            deferred={index > 0}
          />
        ))
      }
    </div>
    <div class="shade"></div>
    <div class="grain"></div>
    <div class="hero-content">
      <h1 class="hero-catchphrase">
        <span class="hero-catchphrase-line hero-catchphrase-line-beyond">
          <span class="hero-catchphrase-text">I NTO</span>
        </span>
        <span class="hero-catchphrase-line hero-catchphrase-line-the">
          <span class="hero-catchphrase-text">THE</span>
        </span>
        <span class="hero-catchphrase-line hero-catchphrase-line-dream">
          <span class="hero-catchphrase-text">LIGHT.</span>
        </span>
      </h1>
    </div>
  </main>
</SiteLayout>

<script>
  import gsap from 'gsap';

  const slides = gsap.utils.toArray<HTMLImageElement>('.hero-slide');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;
  let slideshowTimer: number | undefined;

  const stopSlideshow = () => {
    if (slideshowTimer !== undefined) {
      window.clearInterval(slideshowTimer);
      slideshowTimer = undefined;
    }
    gsap.killTweensOf(slides);
  };

  // 2枚目以降のスライドは、ページの表示が終わってから読み込む
  const loadDeferredImages = () => {
    document.querySelectorAll<HTMLImageElement>('img[data-deferred-image]').forEach((image) => {
      const source = image.parentElement?.querySelector<HTMLSourceElement>('source[data-srcset]');
      if (source?.dataset.srcset) {
        source.srcset = source.dataset.srcset;
        source.removeAttribute('data-srcset');
      }
      if (image.dataset.src) {
        image.src = image.dataset.src;
        image.removeAttribute('data-src');
      }
      image.removeAttribute('data-deferred-image');
    });
  };

  if (document.readyState === 'complete') loadDeferredImages();
  else window.addEventListener('load', loadDeferredImages, { once: true });

  const startSlideshow = () => {
    if (!slides.length) return;

    stopSlideshow();
    current = 0;
    gsap.set(slides, { opacity: 0, xPercent: 100, zIndex: 0 });
    gsap.set(slides[0], { opacity: 1, xPercent: 0, scale: 1.08, zIndex: 1 });
    slides.forEach((slide, index) => slide.setAttribute('aria-hidden', String(index !== 0)));

    if (reduceMotion || slides.length < 2) return;

    gsap.to(slides[0], { scale: 1, duration: 4.1, ease: 'none' });
    slideshowTimer = window.setInterval(() => {
      loadDeferredImages();
      const previous = slides[current];
      current = (current + 1) % slides.length;
      const next = slides[current];

      previous.setAttribute('aria-hidden', 'true');
      next.setAttribute('aria-hidden', 'false');

      gsap
        .timeline()
        .set(next, { opacity: 1, xPercent: 100, scale: 1.08, zIndex: 2 })
        .to(previous, { xPercent: -100, duration: 1.05, ease: 'power3.inOut' }, 0)
        .to(next, { xPercent: 0, duration: 1.05, ease: 'power3.inOut' }, 0)
        .set(previous, { opacity: 0, xPercent: 100, zIndex: 0 })
        .set(next, { zIndex: 1 })
        .to(next, { scale: 1, duration: 4.1, ease: 'none' });
    }, 5200);
  };

  startSlideshow();
  window.addEventListener('pagehide', stopSlideshow);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) startSlideshow();
  });
</script>
