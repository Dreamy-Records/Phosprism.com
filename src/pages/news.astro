---
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsListing from '../components/NewsListing.astro';
import { defaultLabel } from '../data/labels';
import { articlesPerPage, countNews, getNewsByLabel, pageCount } from '../utils/newsPages';

const newsByLabel = await getNewsByLabel();
const articles = newsByLabel[defaultLabel];
---

<SiteLayout title="News — Phos'Prism" page="news">
  <NewsListing
    label={defaultLabel}
    labelCounts={countNews(newsByLabel)}
    articles={articles.slice(0, articlesPerPage)}
    allArticles={articles}
    currentPage={1}
    totalPages={pageCount(articles)}
    startIndex={0}
  />
</SiteLayout>
